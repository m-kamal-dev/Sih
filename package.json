{
  "name": "evidencegraph",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "cd apps/web && node node_modules/next/dist/bin/next dev -p 3100",
    "build": "cd apps/web && node node_modules/next/dist/bin/next build",
    "start": "cd apps/web && node node_modules/next/dist/bin/next start -p 3100",
    "typecheck": "tsc -p packages/domain && tsc -p packages/engine && tsc -p packages/fixtures && tsc -p apps/web",
    "lint": "cd apps/web && node node_modules/next/dist/bin/next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:pii": "node scripts/grep-pii.ts",
    "check:wording": "node scripts/check-wording.ts",
    "demo": "node scripts/demo.mjs",
    "e2e": "cd apps/web && node node_modules/@playwright/test/cli.js test",
    "e2e:ui": "cd apps/web && node node_modules/@playwright/test/cli.js test --ui",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
