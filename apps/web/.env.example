# Copy this file to apps/web/.env.local (never commit .env.local). Restart the server after changes.
#
# Without any of these the app works fully in "Rules-only mode": every forensic check, rule,
# ledger entry and the built-in reader run locally with no key and no network.
#
# PRIVACY: in Ollama cloud mode the VISIBLE text of each uploaded document is sent to ollama.com.
# Hidden text is never sent. Use only the synthetic sample PDFs for demos.

# --- Ollama hosted API (default AI provider) ---
# Key from https://ollama.com/settings/keys. Sent as "Authorization: Bearer <key>".
OLLAMA_API_KEY=
# Base URL. Defaults to https://ollama.com when a key is set.
# OLLAMA_BASE_URL=https://ollama.com
# Model for reading and explaining. Direct ollama.com API names have no suffix (e.g. gpt-oss:120b);
# when routing through a local Ollama server, cloud models use the "-cloud" suffix (e.g. gpt-oss:120b-cloud).
# OLLAMA_MODEL=gpt-oss:120b
# Optional model for base64 images (image URLs are not supported). Defaults to OLLAMA_MODEL.
# OLLAMA_VISION_MODEL=

# --- Optional: local Ollama server instead of the cloud (no key, no GPU needed for cloud models) ---
# Leave OLLAMA_API_KEY empty and set:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
